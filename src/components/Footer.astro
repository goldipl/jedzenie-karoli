---
import Icon from './Icon.astro';
import { navigation, site } from '@/data/site';
import { withBase } from '@/utils/url';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="footer__logo" href={withBase('/')}>
          <span class="footer__badge"><Icon name="bowl" size={22} /></span>
          {site.name}
        </a>
        <p class="footer__tagline">Przepisy bez glutenu, które smakują wszystkim.</p>
      </div>

      <nav class="footer__nav" aria-label="Stopka">
        <ul>
          <li><a href="#start">Start</a></li>
          {
            navigation.map(({ label, href }) => (
              <li>
                <a href={href}>{label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <a class="footer__social" href={site.instagram} target="_blank" rel="noopener noreferrer">
        <Icon name="instagram" size={20} />
        {site.instagramHandle}
      </a>
    </div>

    <div class="footer__bottom">
      <p>{site.copyright} &copy; <span data-year>{year}</span></p>
      <p>Zrobione z <Icon name="heart" size={14} class="footer__heart" /> i bez glutenu</p>
    </div>
  </div>
</footer>

<a class="to-top" href="#start" aria-label="Wróć na górę strony" data-to-top>
  <Icon name="arrowUp" size={22} />
</a>

<script>
  // The site is static, so refresh the year client-side in case it was built last year.
  const year = document.querySelector('[data-year]');
  if (year) year.textContent = String(new Date().getFullYear());

  const toTop = document.querySelector<HTMLElement>('[data-to-top]')!;
  const onScroll = () => toTop.toggleAttribute('data-visible', window.scrollY > 800);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style lang="scss">
  @use '../styles/mixins' as *;

  .footer {
    padding-block: 3.5rem 2rem;
    background: var(--brown-900);
    color: rgb(255 255 255 / 75%);
    font-size: 0.9375rem;

    a {
      color: #fff;
      text-decoration: none;
      transition: color var(--transition);

      &:hover {
        color: var(--orange-300);
      }
    }
  }

  .footer__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid rgb(255 255 255 / 10%);
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-script);
    font-size: 1.125rem;
  }

  .footer__badge {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--orange-400), var(--orange-600));
    color: #fff;
  }

  .footer__tagline {
    margin-top: 0.75rem;
  }

  .footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__social {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.125rem;
    border: 1px solid rgb(255 255 255 / 18%);
    border-radius: 999px;
    font-weight: 700;

    &:hover {
      border-color: var(--orange-300);
    }
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-top: 1.5rem;
    font-size: 0.875rem;

    p {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
    }

    :global(.footer__heart) {
      color: var(--orange-400);
      fill: currentColor;
    }
  }

  .to-top {
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 90;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: #fff;
    box-shadow: 0 10px 24px -8px rgb(194 65 12 / 70%);
    opacity: 0;
    visibility: hidden;
    transform: translateY(1rem);
    transition:
      opacity var(--transition),
      transform var(--transition),
      visibility var(--transition),
      background-color var(--transition);

    &[data-visible] {
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    &:hover {
      background: var(--color-primary-hover);
    }
  }
</style>
