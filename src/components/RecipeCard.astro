---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { categoryLabels } from '@/data/categories';

interface Props {
  recipe: CollectionEntry<'recipes'>;
}

const { recipe } = Astro.props;
const { title, image, imageAlt, url, category } = recipe.data;
---

<li class="card" data-category={category}>
  <a class="card__link" href={url} target="_blank" rel="noopener noreferrer">
    <div class="card__media">
      <Image
        class="card__image"
        src={image}
        alt={imageAlt}
        width={600}
        widths={[320, 480, 600]}
        sizes="(max-width: 640px) 92vw, (max-width: 960px) 45vw, 280px"
      />
      <span class="card__badge">{categoryLabels[category]}</span>
    </div>
    <div class="card__body">
      <h3 class="card__title">{title}</h3>
      <span class="card__more">
        Zobacz przepis
        <Icon name="external" size={14} />
        <span class="visually-hidden">(Instagram, nowa karta)</span>
      </span>
    </div>
  </a>
</li>

<style lang="scss">
  .card {
    display: flex;
  }

  .card__link {
    display: flex;
    flex-direction: column;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: inherit;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--transition),
      box-shadow var(--transition),
      border-color var(--transition);

    &:hover {
      transform: translateY(-4px);
      border-color: var(--orange-200);
      box-shadow: var(--shadow);

      :global(.card__image) {
        transform: scale(1.06);
      }

      .card__title {
        color: var(--color-primary);
      }
    }
  }

  .card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .card :global(.card__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .card__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 92%);
    color: var(--orange-800);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    backdrop-filter: blur(4px);
  }

  .card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem 1.125rem 1.25rem;
  }

  .card__title {
    font-size: 1.125rem;
    line-height: 1.3;
    transition: color var(--transition);
  }

  .card__more {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: auto;
    color: var(--color-primary);
    font-size: 0.875rem;
    font-weight: 700;
  }
</style>
