---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  slides: CollectionEntry<'slides'>[];
}

const { slides } = Astro.props;
---

<section id="start" class="hero" aria-label="Polecane przepisy">
  <div class="swiper" data-slider>
    <div class="swiper-wrapper">
      {
        slides.map(({ data }, index) => (
          <div class="swiper-slide">
            <a class="slide" href={data.url} target="_blank" rel="noopener noreferrer">
              <Image
                class="slide__image"
                src={data.image}
                alt={data.imageAlt}
                width={1200}
                widths={[400, 600, 900, 1200]}
                sizes="(max-width: 640px) 90vw, (max-width: 1000px) 48vw, 32vw"
                loading={index < 3 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : 'auto'}
              />
              <div class="slide__caption">
                <h2>{data.title}</h2>
                <p>{data.description}</p>
              </div>
            </a>
          </div>
        ))
      }
    </div>

    <button class="hero__nav hero__nav--prev" type="button" aria-label="Poprzedni slajd" data-prev>
      <Icon name="arrowLeft" size={28} />
    </button>
    <button class="hero__nav hero__nav--next" type="button" aria-label="Następny slajd" data-next>
      <Icon name="arrowRight" size={28} />
    </button>
    <div class="hero__pagination" data-pagination></div>
  </div>
</section>

<script>
  import Swiper from 'swiper';
  import { A11y, Autoplay, Keyboard, Navigation, Pagination } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/a11y';
  import 'swiper/css/pagination';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((el) => {
    new Swiper(el, {
      modules: [A11y, Autoplay, Keyboard, Navigation, Pagination],
      slidesPerView: 1.15,
      spaceBetween: 12,
      loop: true,
      grabCursor: true,
      keyboard: { enabled: true },
      autoplay: reduceMotion
        ? false
        : { delay: 3500, disableOnInteraction: false, pauseOnMouseEnter: true },
      navigation: {
        prevEl: el.querySelector<HTMLElement>('[data-prev]'),
        nextEl: el.querySelector<HTMLElement>('[data-next]'),
      },
      pagination: {
        el: el.querySelector<HTMLElement>('[data-pagination]'),
        clickable: true,
      },
      a11y: {
        prevSlideMessage: 'Poprzedni slajd',
        nextSlideMessage: 'Następny slajd',
        paginationBulletMessage: 'Przejdź do slajdu {{index}}',
      },
      breakpoints: {
        640: { slidesPerView: 2, spaceBetween: 16 },
        1000: { slidesPerView: 3, spaceBetween: 24 },
      },
    });
  });
</script>

<style lang="scss">
  @use '../styles/mixins' as *;

  .hero {
    padding-block: 0 1rem;
  }

  .swiper {
    position: relative;
    width: 96vw;
    padding-bottom: 2rem;

    @include below($bp-sm) {
      width: 100vw;
    }

    // Soft fade on the edges.
    &::before,
    &::after {
      content: '';
      position: absolute;
      inset-block: 0;
      z-index: 2;
      width: 1rem;
      pointer-events: none;
    }

    &::before {
      left: 0;
      background: linear-gradient(to left, transparent, var(--color-light));
    }

    &::after {
      right: 0;
      background: linear-gradient(to right, transparent, var(--color-light));
    }
  }

  .swiper-slide {
    height: auto;
  }

  .slide {
    position: relative;
    display: block;
    height: clamp(320px, 50vh, 480px);
    overflow: hidden;
    border: 1px solid var(--color-dark);
    border-radius: var(--radius);
    box-shadow: 2px 2px 16px -8px #bbb;
    color: inherit;
    text-decoration: none;

    &:hover :global(.slide__image),
    &:focus-visible :global(.slide__image) {
      filter: brightness(75%);
      transform: scale(1.03);
    }
  }

  .slide :global(.slide__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.5s ease,
      filter var(--transition);
  }

  .slide__caption {
    @include overlay-caption;

    h2,
    p {
      margin: 0.25rem auto;
    }

    h2 {
      font-size: clamp(1rem, 2.4vw, 1.5rem);
    }

    p {
      font-size: clamp(0.8125rem, 1.6vw, 1rem);
    }
  }

  .hero__nav {
    position: absolute;
    top: calc(50% - 1rem);
    z-index: 3;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3.5rem;
    border: 0;
    border-radius: 12px;
    background: var(--color-light);
    color: #111;
    box-shadow: 0 2px 12px -4px rgb(0 0 0 / 40%);
    cursor: pointer;
    translate: 0 -50%;
    transition:
      background-color var(--transition),
      color var(--transition);

    &:hover {
      background: var(--color-accent);
    }

    @include below($bp-sm) {
      display: none;
    }
  }

  .hero__nav--prev {
    left: 1rem;
  }

  .hero__nav--next {
    right: 1rem;
  }

  .hero__pagination {
    position: absolute;
    inset: auto 0 0;
    z-index: 3;
    display: flex;
    justify-content: center;
    gap: 0.25rem;

    :global(.swiper-pagination-bullet) {
      width: 12px;
      height: 12px;

      @include below($bp-sm) {
        width: 8px;
        height: 8px;
      }
    }

    :global(.swiper-pagination-bullet-active) {
      background-color: var(--color-dark);
    }
  }
</style>
