---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  slides: CollectionEntry<'slides'>[];
}

const { slides } = Astro.props;
---

<section id="polecane" class="featured section" aria-labelledby="polecane-title">
  <div class="container">
    <div class="featured__head">
      <div>
        <p class="eyebrow">Polecane</p>
        <h2 id="polecane-title" class="section-title">Ulubione przepisy</h2>
      </div>
      <div class="featured__controls">
        <button class="featured__nav" type="button" aria-label="Poprzedni slajd" data-prev>
          <Icon name="arrowLeft" size={22} />
        </button>
        <button class="featured__nav" type="button" aria-label="Następny slajd" data-next>
          <Icon name="arrowRight" size={22} />
        </button>
      </div>
    </div>

    <div class="swiper" data-slider>
      <div class="swiper-wrapper">
        {
          slides.map(({ data }) => (
            <div class="swiper-slide">
              <a class="slide" href={data.url} target="_blank" rel="noopener noreferrer">
                <div class="slide__media">
                  <Image
                    class="slide__image"
                    src={data.image}
                    alt={data.imageAlt}
                    width={900}
                    widths={[360, 600, 900]}
                    sizes="(max-width: 640px) 85vw, (max-width: 960px) 45vw, 380px"
                  />
                </div>
                <div class="slide__body">
                  <h3 class="slide__title">{data.title}</h3>
                  <p class="slide__desc">{data.description}</p>
                  <span class="slide__more">
                    Zobacz przepis <Icon name="arrowLong" size={16} />
                  </span>
                </div>
              </a>
            </div>
          ))
        }
      </div>
      <div class="featured__pagination" data-pagination></div>
    </div>
  </div>
</section>

<script>
  import Swiper from 'swiper';
  import { A11y, Autoplay, Keyboard, Navigation, Pagination } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/a11y';
  import 'swiper/css/pagination';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-slider]').forEach((el) => {
    const section = el.closest('section')!;
    new Swiper(el, {
      modules: [A11y, Autoplay, Keyboard, Navigation, Pagination],
      slidesPerView: 1.15,
      spaceBetween: 16,
      loop: true,
      grabCursor: true,
      keyboard: { enabled: true, onlyInViewport: true },
      autoplay: reduceMotion
        ? false
        : { delay: 4500, disableOnInteraction: false, pauseOnMouseEnter: true },
      navigation: {
        prevEl: section.querySelector<HTMLElement>('[data-prev]'),
        nextEl: section.querySelector<HTMLElement>('[data-next]'),
      },
      pagination: {
        el: el.querySelector<HTMLElement>('[data-pagination]'),
        clickable: true,
      },
      a11y: {
        prevSlideMessage: 'Poprzedni slajd',
        nextSlideMessage: 'Następny slajd',
        paginationBulletMessage: 'Przejdź do slajdu {{index}}',
      },
      breakpoints: {
        640: { slidesPerView: 2.1, spaceBetween: 20 },
        960: { slidesPerView: 3, spaceBetween: 24 },
      },
    });
  });
</script>

<style lang="scss">
  @use '../styles/mixins' as *;

  .featured {
    padding-top: clamp(2rem, 5vw, 4rem);
  }

  .featured__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .featured__controls {
    display: flex;
    gap: 0.5rem;

    @include below($bp-sm) {
      display: none;
    }
  }

  .featured__nav {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition:
      background-color var(--transition),
      color var(--transition),
      border-color var(--transition);

    &:hover {
      border-color: var(--color-primary);
      background: var(--color-primary);
      color: #fff;
    }
  }

  .swiper {
    padding: 0.5rem 0.5rem 3rem;
    margin: -0.5rem;
  }

  .swiper-slide {
    height: auto;
  }

  .slide {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: inherit;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition:
      box-shadow var(--transition),
      transform var(--transition);

    &:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow);

      :global(.slide__image) {
        transform: scale(1.05);
      }

      .slide__more {
        gap: 0.625rem;
      }
    }
  }

  .slide__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .slide :global(.slide__image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .slide__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1.25rem 1.375rem 1.5rem;
  }

  .slide__title {
    font-size: 1.375rem;
  }

  .slide__desc {
    color: var(--color-muted);
  }

  .slide__more {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: auto;
    padding-top: 0.75rem;
    color: var(--color-primary);
    font-weight: 700;
    font-size: 0.9375rem;
    transition: gap var(--transition);
  }

  .featured__pagination {
    position: absolute;
    inset: auto 0 0.5rem;
    display: flex;
    justify-content: center;
    gap: 0.375rem;

    :global(.swiper-pagination-bullet) {
      width: 8px;
      height: 8px;
      margin: 0 !important;
      background: var(--orange-300);
      opacity: 1;
      transition:
        width var(--transition),
        background-color var(--transition);
    }

    :global(.swiper-pagination-bullet-active) {
      width: 24px;
      border-radius: 4px;
      background: var(--color-primary);
    }
  }
</style>
