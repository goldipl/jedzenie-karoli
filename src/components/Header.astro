---
import Icon from './Icon.astro';
import { navigation, site } from '@/data/site';
import { withBase } from '@/utils/url';
---

<header class="header" data-header>
  <div class="header__inner container">
    <a class="logo" href={withBase('/')} aria-label={`${site.name} – strona główna`}>
      <span class="logo__badge"><Icon name="bowl" size={26} /></span>
      <span class="logo__text">
        {site.name}
        <span class="logo__tagline">{site.tagline}</span>
      </span>
    </a>

    <button
      class="burger"
      type="button"
      aria-controls="main-nav"
      aria-expanded="false"
      aria-label="Otwórz menu"
      data-burger
    >
      <Icon name="menu" class="burger__open" size={26} />
      <Icon name="close" class="burger__close" size={26} />
    </button>

    <nav id="main-nav" class="nav" aria-label="Główna nawigacja" data-nav>
      <ul class="nav__list">
        {
          navigation.map(({ label, href }) => (
            <li>
              <a class="nav__link" href={href} data-nav-link>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--primary nav__cta" href={site.instagram} target="_blank" rel="noopener noreferrer">
        <Icon name="instagram" size={18} />
        Instagram
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const burger = header.querySelector<HTMLButtonElement>('[data-burger]')!;
  const links = [...header.querySelectorAll<HTMLAnchorElement>('[data-nav-link]')];

  function setOpen(open: boolean) {
    header.toggleAttribute('data-open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Zamknij menu' : 'Otwórz menu');
  }

  burger.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));
  header.querySelectorAll('[data-nav] a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && header.hasAttribute('data-open')) {
      setOpen(false);
      burger.focus();
    }
  });

  document.addEventListener('click', (event) => {
    if (header.hasAttribute('data-open') && !header.contains(event.target as Node)) setOpen(false);
  });

  window.matchMedia('(min-width: 960px)').addEventListener('change', () => setOpen(false));

  // Elevate the header once the page is scrolled.
  const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Highlight the link of the section currently in view.
  const sections = links
    .map((link) => document.querySelector<HTMLElement>(link.hash))
    .filter((section): section is HTMLElement => section !== null);

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        links.forEach((link) => {
          if (link.hash === `#${entry.target.id}`) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        });
      });
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  sections.forEach((section) => observer.observe(section));
</script>

<style lang="scss">
  @use '../styles/mixins' as *;

  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgb(255 250 245 / 82%);
    backdrop-filter: saturate(1.6) blur(14px);
    border-bottom: 1px solid transparent;
    transition:
      box-shadow var(--transition),
      border-color var(--transition);

    &[data-scrolled] {
      border-color: var(--color-border);
      box-shadow: 0 8px 24px -16px rgb(61 36 20 / 35%);
    }
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: var(--header-height);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-text);
    text-decoration: none;
  }

  .logo__badge {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 14px;
    background: linear-gradient(135deg, var(--orange-400), var(--orange-600));
    color: #fff;
    box-shadow: 0 6px 16px -6px rgb(234 88 12 / 70%);
    transition: transform var(--transition);
  }

  .logo:hover .logo__badge {
    transform: rotate(-8deg) scale(1.05);
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    font-family: var(--font-script);
    font-size: 1.125rem;
    line-height: 1.4;
  }

  .logo__tagline {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-primary);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav__list {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__link {
    position: relative;
    display: block;
    padding: 0.5rem 0.875rem;
    color: var(--color-text);
    font-weight: 500;
    text-decoration: none;
    transition: color var(--transition);

    &::after {
      content: '';
      position: absolute;
      inset: auto 0.875rem 0.25rem;
      height: 2px;
      border-radius: 2px;
      background: var(--color-accent);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform var(--transition);
    }

    &:hover,
    &[aria-current] {
      color: var(--color-primary);

      &::after {
        transform: scaleX(1);
      }
    }
  }

  .nav__cta {
    min-height: 2.5rem;
    padding: 0.5rem 1.125rem;
    font-size: 0.9375rem;
  }

  .burger {
    display: none;
  }

  @include below($bp-md) {
    .burger {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 1px solid var(--color-border);
      border-radius: 12px;
      background: var(--color-surface);
      color: var(--color-text);
      cursor: pointer;

      :global(svg) {
        grid-area: 1 / 1;
        transition:
          opacity var(--transition),
          transform var(--transition);
      }

      :global(.burger__close) {
        opacity: 0;
        transform: rotate(-90deg);
      }
    }

    .nav {
      position: absolute;
      inset: calc(100% + 0.5rem) var(--gutter) auto;
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      padding: 1rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      background: var(--color-surface);
      box-shadow: var(--shadow);
      visibility: hidden;
      opacity: 0;
      transform: translateY(-0.5rem) scale(0.98);
      transform-origin: top right;
      transition:
        opacity var(--transition),
        transform var(--transition),
        visibility var(--transition);
    }

    .nav__list {
      flex-direction: column;
    }

    .nav__link {
      padding: 0.875rem 1rem;
      border-radius: var(--radius-sm);
      font-size: 1.125rem;

      &::after {
        display: none;
      }

      &:hover,
      &[aria-current] {
        background: var(--orange-50);
      }
    }

    .header[data-open] {
      .nav {
        visibility: visible;
        opacity: 1;
        transform: none;
      }

      .burger :global(.burger__open) {
        opacity: 0;
        transform: rotate(90deg);
      }

      .burger :global(.burger__close) {
        opacity: 1;
        transform: none;
      }
    }
  }

  @include below($bp-sm) {
    .logo__badge {
      width: 38px;
      height: 38px;
      border-radius: 12px;
    }

    .logo__text {
      font-size: 0.9375rem;
    }

    .logo__tagline {
      font-size: 0.6875rem;
    }
  }
</style>
