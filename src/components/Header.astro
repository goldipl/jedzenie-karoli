---
import Icon from './Icon.astro';
import { navigation, site } from '@/data/site';
import { withBase } from '@/utils/url';
---

<header class="header" data-header>
  <div class="header__inner">
    <a class="logo" href={withBase('/')} aria-label={`${site.name} – strona główna`}>
      <Icon name="bowl" class="logo__icon" size={44} />
      <span class="logo__text">
        {site.name}
        <span class="logo__tagline">{site.tagline}</span>
      </span>
    </a>

    <button
      class="burger"
      type="button"
      aria-controls="main-nav"
      aria-expanded="false"
      data-burger
    >
      <Icon name="menu" class="burger__open" size={32} />
      <Icon name="close" class="burger__close" size={32} />
      <span class="burger__label">Menu</span>
    </button>

    <nav id="main-nav" class="nav" aria-label="Główna nawigacja">
      <ul class="nav__list">
        {
          navigation.map(({ label, href }) => (
            <li>
              <a class="nav__link" href={href} data-nav-link>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const burger = header?.querySelector<HTMLButtonElement>('[data-burger]');
  const mobileQuery = window.matchMedia('(max-width: 999.98px)');

  function setOpen(open: boolean) {
    if (!header || !burger) return;
    header.toggleAttribute('data-open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.querySelector('.burger__label')!.textContent = open ? 'Zamknij' : 'Menu';
  }

  burger?.addEventListener('click', () => setOpen(!header?.hasAttribute('data-open')));

  header?.querySelectorAll('[data-nav-link]').forEach((link) =>
    link.addEventListener('click', () => setOpen(false)),
  );

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && header?.hasAttribute('data-open')) {
      setOpen(false);
      burger?.focus();
    }
  });

  mobileQuery.addEventListener('change', () => setOpen(false));
</script>

<style lang="scss">
  @use '../styles/mixins' as *;

  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    display: flex;
    justify-content: center;
    background: var(--gradient-dark);
    box-shadow: 0 2px 16px -2px #888;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: min(1200px, 100%);
    height: var(--header-height);
    padding-inline: 1rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-light);
    text-decoration: none;
  }

  .logo :global(.logo__icon) {
    flex-shrink: 0;
    color: var(--color-accent);
  }

  .logo__text {
    position: relative;
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.3;
  }

  .logo__tagline {
    align-self: flex-end;
    margin-right: -1.5rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-accent);
  }

  .nav__list {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__link {
    display: block;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--color-accent);
    border-radius: 6px;
    color: var(--color-light);
    font-size: 1.125rem;
    text-decoration: none;
    transition:
      background-color var(--transition),
      color var(--transition);

    &:hover,
    &:focus-visible {
      background-color: var(--color-accent);
      color: var(--color-dark);
    }
  }

  .burger {
    display: none;
  }

  @include below($bp-md) {
    .burger {
      position: relative;
      display: grid;
      place-items: center;
      padding: 0.25rem 0.25rem 0.75rem;
      border: 0;
      background: none;
      color: var(--color-accent);
      cursor: pointer;

      :global(svg) {
        grid-area: 1 / 1;
        transition:
          opacity var(--transition),
          transform var(--transition);
      }
    }

    .burger :global(.burger__close) {
      opacity: 0;
      transform: rotate(-90deg);
    }

    .burger__label {
      position: absolute;
      bottom: 0;
      font-size: 0.625rem;
      text-transform: uppercase;
      color: var(--color-light);
    }

    .header[data-open] {
      .burger :global(.burger__open) {
        opacity: 0;
        transform: rotate(90deg);
      }

      .burger :global(.burger__close) {
        opacity: 1;
        transform: rotate(0);
      }

      .nav {
        visibility: visible;
        opacity: 1;
        transform: translateY(0);
      }
    }

    .nav {
      position: absolute;
      inset: var(--header-height) 0 auto;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-0.5rem);
      background: var(--gradient-dark);
      box-shadow: 0 12px 16px -12px #000;
      transition:
        opacity var(--transition),
        transform var(--transition),
        visibility var(--transition);
    }

    .nav__list {
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      padding: 1.5rem 1rem 2rem;
    }

    .nav__link {
      min-width: 12rem;
      text-align: center;
    }
  }

  @include below($bp-sm) {
    .logo :global(.logo__icon) {
      width: 32px;
      height: 32px;
    }

    .logo__text {
      font-size: 1rem;
    }

    .logo__tagline {
      font-size: 0.75rem;
    }
  }
</style>
